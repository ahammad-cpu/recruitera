{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/login.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/crm", "destination": "/crm.html" },
    { "source": "/crm-preview", "destination": "/crm-preview.html" },
    { "source": "/crm-v2", "destination": "/crm-v2.html" },
    { "source": "/crm-v3", "destination": "/crm-v3/index.html" },
    { "source": "/crm-v3/((?!assets/).*)", "destination": "/crm-v3/index.html" },
    { "source": "/migrate", "destination": "/migrate.html" },
    { "source": "/sync-admin", "destination": "/sync-admin.html" }
  ],
  "headers": [
    {
      "source": "/(crm|crm-v2|crm-v3|login|migrate|sync-admin)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate" }
      ]
    },
    {
      "source": "/(crm|crm-v2|login|migrate|sync-admin).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate" }
      ]
    },
    {
      "source": "/crm-v3/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate" }
      ]
    },
    {
      "source": "/crm-v3/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
